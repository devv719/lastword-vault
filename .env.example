# ===================================================================
# LastWord — Dead Man's Switch Vault
# Local Development Environment Variables
# ===================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# In production, secrets are read from AWS SSM Parameter Store.
# ===================================================================

# ── PostgreSQL (local Docker) ─────────────────────────────────────
POSTGRES_USER=lastword
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=lastword
DATABASE_URL=postgresql+asyncpg://lastword:changeme_local_only@localhost:5432/lastword

# ── JWT ───────────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=1440

# ── AWS (leave blank for local dev) ──────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
SNS_TOPIC_ARN=
SES_SENDER_EMAIL=devvv0793@gmail.com
# Base URL used for generated verification & release links in emails
FRONTEND_URL=http://3.109.2.254

# ── Application ──────────────────────────────────────────────────
APP_ENV=development
DEMO_MODE=true
DEMO_CHECKIN_INTERVAL_SECONDS=120
DEMO_GRACE_PERIOD_SECONDS=60
DEFAULT_CHECKIN_INTERVAL_HOURS=72
DEFAULT_GRACE_PERIOD_HOURS=24

# ── SSM (production only) ────────────────────────────────────────
USE_SSM=false
SSM_PREFIX=/lastword

# ── Backend & Production Domain ────────────────────────────────
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Production domain for automatic HTTPS via Let's Encrypt / Caddy
# e.g. DOMAIN=3.109.2.254.sslip.io OR DOMAIN=your-name.duckdns.org OR DOMAIN=vault.yourdomain.com
DOMAIN=
